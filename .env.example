# --- Docker Compose configuration -------------------------------------------
# Copy to .env and adjust. Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Postgres password used inside the compose network.
POSTGRES_PASSWORD=tracer

# Password for the seeded demo account (demo@agenttracer.dev).
DEMO_PASSWORD=demo-password

# Host ports.
WEB_PORT=3000
API_PORT=8000

# production | development — production refuses to start with the default secret.
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Local development (server run outside Docker) ---------------------------
# The API server reads these directly (see server/app/config.py):
# DATABASE_URL=postgresql+asyncpg://tracer:tracer@localhost:5432/agent_tracer
# CORS_ORIGINS=http://localhost:5173
